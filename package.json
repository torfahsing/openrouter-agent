    "@openrouter/agent": "^0.11.0",
    "ajv": "^8.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.11.0",
    "typescript": "^5.7.0"
  }
}
